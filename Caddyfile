(promomega_app) {
	encode zstd gzip
	reverse_proxy bot:3000

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

:80 {
	import promomega_app
}

promomega.com.br {
	import promomega_app
}

www.promomega.com.br {
	redir https://promomega.com.br{uri} permanent
}

evolution.promomega.com.br {
	encode zstd gzip
	reverse_proxy evolution:8080

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
